{
  "name": "catering-quotation-web-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first catering quotation editor with client/chef PDF export and Claude assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
