    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
